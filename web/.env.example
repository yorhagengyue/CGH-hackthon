# Database (omit locally to use the PGlite development database)
DATABASE_URL=

# Twilio SMS (leave all three blank to simulate queued SMS locally)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Protects GET/POST /api/sms; set in Vercel project settings for cron runs
CRON_SECRET=

# Public origin used in reminder links
APP_URL=http://localhost:3000
